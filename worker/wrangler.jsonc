{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The fetch proxy of the pages, see "Fetch proxy" in README.md
  "name": "credscope-fetch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Only at its custom domain, where the Cache API works
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "credscope-fetch.eudi-wallet.dev", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://credscope.eudi-wallet.dev"
  },
  "observability": { "enabled": true }
}
