{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The fetch proxy of the pages, see "Fetch proxy" in README.md
  "name": "credscope-fetch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Only at its custom domain, where the Cache API works
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "credscope-fetch.eudi-wallet.dev", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://credscope.eudi-wallet.dev"
  },
  // 60 requests a minute for each IP address; the namespace is any number unique in the account
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true }
}
